# Database
DATABASE_URL="postgresql://geo_agent:geo_agent_dev@localhost:5540/geo_agent_dev?schema=public"

# Demo seed — set true for local development, false for production
SEED_DEMO_DATA=false

# Skill Mock 演示：true 时 GEO Hermes 类任务可不绑 Hermes、无需 userConfirmedExecution 即走 fixture
# GEO_SKILL_MOCK_DEMO=true

# Auth mode: demo (infer identity from request params) | session (require login cookie)
# demo 模式下，工作台/排名监控在缺数据时会自动写入演示快照
AUTH_MODE=demo

# 内置 AI：MiniMax（复制 config/minimax.example.json → config/minimax.local.json 并填入 apiKey）
# 勿将 minimax.local.json 提交到 git

# Hermes 开发连调（最少 3 行即可；详见 docs/GEO投放助手_开发阶段Hermes快速连调配置.md）
# Hermes 侧只需: %LOCALAPPDATA%\hermes\.env → API_SERVER_ENABLED=true → 重启 Gateway
HERMES_EXECUTOR=nous_hermes
HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=  # 仅当 Hermes 设置了 API_SERVER_KEY 时填写
# 登录同步 Mock（默认开启）：用户在 Web 端模拟 Hermes 登录后写入演示设备状态；正式联调设为 false
# HERMES_MOCK_LOGIN_SYNC=false
# 验收: node scripts/hermes-dev-link-check.mjs

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000
