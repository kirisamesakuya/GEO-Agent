# Database
# Relative to prisma/schema.prisma — use file:./dev.db (resolves to prisma/dev.db)
DATABASE_URL="file:./dev.db"

# 内置 AI：MiniMax（复制 config/minimax.example.json → config/minimax.local.json 并填入 apiKey）
# 勿将 minimax.local.json 提交到 git

# Hermes Agent API Server（GEO 检测 / 品牌提取等任务必需，已禁用 Mock 降级）
# 验收：npm run dev 后执行 ./scripts/hermes-smoke.sh；检测期间请保持 Gateway（8642）运行
HERMES_EXECUTOR=nous_hermes
HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=your-api-server-key
# HERMES_AGENT_COMMIT=64202200a6043b685750e16107067971446f8818

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
